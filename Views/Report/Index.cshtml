@{
    ViewData["Title"] = "Laporan Transaksi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="max-w-7xl mx-auto p-4 sm:p-6 mt-4 sm:mt-10 bg-white rounded-xl shadow-md border border-gray-200">
    <div class="flex flex-col sm:flex-row justify-between items-center gap-4 sm:gap-0 mb-6">
        <h2 class="text-xl sm:text-2xl font-bold text-gray-800">Laporan Transaksi</h2>
        <a href="#" class="w-full sm:w-auto bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-lg font-semibold text-center">
            <i class="fas fa-file-pdf mr-2"></i>Export PDF
        </a>
    </div>

    <div class="overflow-x-auto -mx-4 sm:mx-0">
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-100 text-gray-700 text-xs sm:text-sm">
                <tr>
                    <th class="px-3 sm:px-6 py-2 sm:py-3 text-left font-semibold">No</th>
                    <th class="px-3 sm:px-6 py-2 sm:py-3 text-left font-semibold hidden sm:table-cell">Nama</th>
                    <th class="px-3 sm:px-6 py-2 sm:py-3 text-left font-semibold">Buku</th>
                    <th class="px-3 sm:px-6 py-2 sm:py-3 text-left font-semibold hidden md:table-cell">Tgl Pinjam</th>
                    <th class="px-3 sm:px-6 py-2 sm:py-3 text-left font-semibold hidden md:table-cell">Tgl Kembali</th>
                    <th class="px-3 sm:px-6 py-2 sm:py-3 text-left font-semibold">Status</th>
                    <th class="px-3 sm:px-6 py-2 sm:py-3 text-left font-semibold">Denda</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-100 text-xs sm:text-sm text-gray-700">
                <tr>
                    <td class="px-3 sm:px-6 py-2 sm:py-4">1</td>
                    <td class="px-3 sm:px-6 py-2 sm:py-4 hidden sm:table-cell">Farhan Fahrezy</td>
                    <td class="px-3 sm:px-6 py-2 sm:py-4">
                        <div>Pemrograman Dasar</div>
                        <div class="text-gray-500 text-xs sm:hidden">Farhan Fahrezy</div>
                        <div class="text-gray-500 text-xs sm:hidden">01-08-2025 s/d 08-08-2025</div>
                    </td>
                    <td class="px-3 sm:px-6 py-2 sm:py-4 hidden md:table-cell">01-08-2025</td>
                    <td class="px-3 sm:px-6 py-2 sm:py-4 hidden md:table-cell">08-08-2025</td>
                    <td class="px-3 sm:px-6 py-2 sm:py-4">
                        <span class="text-green-600 font-medium text-xs sm:text-sm">Dikembalikan</span>
                    </td>
                    <td class="px-3 sm:px-6 py-2 sm:py-4">Rp 0</td>
                </tr>
                <tr>
                    <td class="px-3 sm:px-6 py-2 sm:py-4">2</td>
                    <td class="px-3 sm:px-6 py-2 sm:py-4 hidden sm:table-cell">Arya Dimas Wicaksana</td>
                    <td class="px-3 sm:px-6 py-2 sm:py-4">
                        <div>Algoritma & Struktur Data</div>
                        <div class="text-gray-500 text-xs sm:hidden">Arya Dimas Wicaksana</div>
                        <div class="text-gray-500 text-xs sm:hidden">25-07-2025 s/d 05-08-2025</div>
                    </td>
                    <td class="px-3 sm:px-6 py-2 sm:py-4 hidden md:table-cell">25-07-2025</td>
                    <td class="px-3 sm:px-6 py-2 sm:py-4 hidden md:table-cell">05-08-2025</td>
                    <td class="px-3 sm:px-6 py-2 sm:py-4">
                        <span class="text-red-600 font-medium text-xs sm:text-sm">Terlambat</span>
                    </td>
                    <td class="px-3 sm:px-6 py-2 sm:py-4">Rp 10.000</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
