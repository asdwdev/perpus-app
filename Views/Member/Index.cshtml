@{
    ViewBag.Title = "Anggota Mahasiswa";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="max-w-6xl mx-auto mt-4 sm:mt-10 p-4 sm:p-6 bg-white rounded-xl shadow-md border border-gray-200">
  <div class="flex flex-col sm:flex-row justify-between items-center gap-4 sm:gap-0 mb-6">
    <h2 class="text-xl sm:text-2xl font-bold text-gray-800">Daftar Anggota Mahasiswa</h2>
    <a href="/Member/Create" class="w-full sm:w-auto px-4 py-2 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 text-center">+ Tambah Anggota</a>
  </div>
  <div class="overflow-x-auto bg-white rounded-lg shadow -mx-4 sm:mx-0">
    <table class="w-full text-left table-auto">
      <thead class="bg-gray-100 text-gray-700 text-xs sm:text-sm uppercase tracking-wider">
        <tr>
          <th class="p-2 sm:p-4">No</th>
          <th class="p-2 sm:p-4 hidden sm:table-cell">NIM</th>
          <th class="p-2 sm:p-4">Nama</th>
          <th class="p-2 sm:p-4 hidden md:table-cell">Fakultas</th>
          <th class="p-2 sm:p-4 hidden md:table-cell">Prodi</th>
          <th class="p-2 sm:p-4 hidden sm:table-cell">Tahun</th>
          <th class="p-2 sm:p-4 text-center">Aksi</th>
        </tr>
      </thead>
      <tbody class="text-sm">
        <!-- Contoh data statis -->
        <tr class="bg-white hover:bg-gray-50 border-b">
          <td class="p-2 sm:p-4">1</td>
          <td class="p-2 sm:p-4 hidden sm:table-cell">12345678</td>
          <td class="p-2 sm:p-4">
            <div class="font-medium">Andi Pratama</div>
            <div class="text-gray-500 text-xs sm:hidden">
              NIM: 12345678 • 2022
            </div>
            <div class="text-gray-500 text-xs sm:hidden">
              Teknik Informatika
            </div>
          </td>
          <td class="p-2 sm:p-4 hidden md:table-cell">Fakultas Teknik</td>
          <td class="p-2 sm:p-4 hidden md:table-cell">Teknik Informatika</td>
          <td class="p-2 sm:p-4 hidden sm:table-cell">2022</td>
          <td class="p-2 sm:p-4">
            <div class="flex flex-col sm:flex-row justify-center gap-2 sm:gap-2">
              <a href="/Member/Edit" class="px-3 py-1 bg-yellow-400 text-white rounded hover:bg-yellow-500 text-center text-sm">Edit</a>
              <button onclick="hapusAnggota('12345678')" class="px-3 py-1 bg-red-600 text-white rounded hover:bg-red-700 text-center text-sm">Hapus</button>
            </div>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</div>

<script>
  function hapusAnggota(nim) {
    Swal.fire({
      title: 'Konfirmasi Hapus',
      text: `Yakin ingin menghapus anggota dengan NIM ${nim}?`,
      icon: 'warning',
      showCancelButton: true,
      confirmButtonColor: '#dc2626',
      cancelButtonColor: '#6b7280',
      confirmButtonText: 'Ya, Hapus!',
      cancelButtonText: 'Batal'
    }).then((result) => {
      if (result.isConfirmed) {
        // Lakukan proses delete (bisa pakai fetch/ajax ke backend)
        Swal.fire('Berhasil!', 'Data anggota telah dihapus.', 'success');
      }
    });
  }
</script>
