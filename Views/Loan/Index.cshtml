@{
  ViewData["Title"] = "Peminjaman Buku";
  Layout = "~/Views/Shared/_Layout.cshtml";
}



<div class="max-w-3xl mx-auto mt-10 p-6 bg-white rounded-xl shadow-md border border-gray-200">
  <h1 class="text-2xl font-bold mb-6 text-center text-gray-800">Form Peminjaman Buku</h1>

  <form onsubmit="return validateStock()" method="post" class="space-y-5">
    <div>
      <label class="block text-sm font-medium text-gray-700">Nama Mahasiswa</label>
      <input type="text" name="nama" required
        class="mt-1 block w-full px-4 py-2 border rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700">Judul Buku</label>
      <select name="buku" id="buku" onchange="updateStok()" required
        class="mt-1 block w-full px-4 py-2 border rounded-md">
        <option value="" disabled selected>Pilih Buku</option>
        <option value="1" data-stok="3">Belajar C# - Stok: 3</option>
        <option value="2" data-stok="0">ASP.NET MVC - Stok: 0</option>
        <option value="3" data-stok="5">Tailwind CSS - Stok: 5</option>
      </select>
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700">Jumlah Dipinjam</label>
      <input type="number" name="jumlah" id="jumlah" min="1" required
        class="mt-1 block w-full px-4 py-2 border rounded-md">
    </div>

    <input type="hidden" id="stokTersedia" value="">

    <div class="flex justify-between">
      <a href="/Loan" class="inline-block px-4 py-2 bg-gray-300 text-gray-700 rounded hover:bg-gray-400">Kembali</a>
      <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700">Pinjam</button>
    </div>
  </form>
</div>

<script>
  function updateStok() {
    const selectedOption = document.querySelector('#buku').selectedOptions[0];
    const stok = selectedOption.getAttribute('data-stok');
    document.getElementById('stokTersedia').value = stok;
  }

  function validateStock() {
    const jumlah = parseInt(document.getElementById('jumlah').value);
    const stok = parseInt(document.getElementById('stokTersedia').value);

    if (jumlah > stok) {
      alert('Stok buku tidak mencukupi!');
      return false;
    }

    return true;
  }
</script>

</html>
