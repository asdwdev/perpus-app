@model perpuss.Models.Loan

@{
  ViewData["Title"] = "Form Peminjaman Buku";
  Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="max-w-3xl mx-auto mt-10 p-6 bg-white rounded-xl shadow-md border border-gray-200">
  <h1 class="text-2xl font-bold mb-6 text-center text-gray-800">Form Peminjaman Buku</h1>

    <form asp-action="Index" method="post" class="space-y-5">
        <div>
            <label class="block text-sm font-medium text-gray-700">Judul Buku</label>
            <select asp-for="BookId" asp-items="ViewBag.BookId" required
            class="mt-1 block w-full px-4 py-2 border rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
            <option value="" disabled selected>-- Pilih Buku --</option>
            </select>
            <span asp-validation-for="BookId" class="text-red-500 text-sm"></span>
        </div>

        <div>
            <label class="block text-sm font-medium text-gray-700">Nama Anggota</label>
            <select asp-for="MemberId" asp-items="ViewBag.MemberId" required
            class="mt-1 block w-full px-4 py-2 border rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
            <option value="" disabled selected>-- Pilih Member --</option>
            </select>
            <span asp-validation-for="MemberId" class="text-red-500 text-sm"></span>
        </div>

        <div>
            <label class="block text-sm font-medium text-gray-700">Tanggal Peminjaman</label>
            <input asp-for="LoanDate" type="date" required
            class="mt-1 block w-full px-4 py-2 border rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
            <span asp-validation-for="LoanDate" class="text-red-500 text-sm"></span>
        </div>

        <div>
            <label class="block text-sm font-medium text-gray-700">Tanggal Pengembalian</label>
            <input asp-for="ReturnDate" type="date" required
            class="mt-1 block w-full px-4 py-2 border rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
            <span asp-validation-for="ReturnDate" class="text-red-500 text-sm"></span>
        </div>

        <div class="flex justify-end gap-3">
             <a href="/Loan" class="inline-block px-4 py-2 bg-gray-300 text-gray-700 rounded hover:bg-gray-400">Reset</a>
            <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700">Pinjam</button>
        </div>
    </form>

</div>


@section Scripts {
    <script>
        @if (TempData["Success"] != null && TempData["Source"]?.ToString() == "Loan")
        {
            <text>
                Swal.fire({
                    icon: 'success',
                    title: 'Berhasil',
                    text: '@TempData["Success"]'
                });
            </text>
        }
    </script>
}
