@{
  ViewData["Title"] = "Pengembalian Buku";
  Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="max-w-3xl mx-auto mt-10 p-6 bg-white rounded-xl shadow-md border border-gray-200">
  <h1 class="text-2xl font-bold mb-6 text-center text-gray-800">Form Pengembalian Buku</h1>

  <form onsubmit="return hitungDenda()" method="post" class="space-y-5">
    <div>
      <label class="block text-sm font-medium text-gray-700">Nama Mahasiswa</label>
      <input type="text" name="nama" required class="mt-1 block w-full px-4 py-2 border rounded-md">
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700">Tanggal Pinjam</label>
      <input type="date" id="tanggalPinjam" name="tanggalPinjam" value="2025-07-28" readonly
        class="mt-1 block w-full px-4 py-2 border rounded-md bg-gray-100 text-gray-600">
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700">Tanggal Kembali</label>
      <input type="date" id="tanggalKembali" name="tanggalKembali" required
        class="mt-1 block w-full px-4 py-2 border rounded-md">
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700">Denda (Rp)</label>
      <input type="text" id="denda" name="denda" readonly
        class="mt-1 block w-full px-4 py-2 border rounded-md bg-gray-100 text-red-600 font-bold">
    </div>

    <div class="flex justify-between">
      <a href="/Return" class="inline-block px-4 py-2 bg-gray-300 text-gray-700 rounded hover:bg-gray-400">Kembali</a>
      <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700">Kembalikan</button>
    </div>
  </form>
</div>

<script>
  function hitungDenda() {
    const tanggalPinjam = new Date(document.getElementById("tanggalPinjam").value);
    const tanggalKembali = new Date(document.getElementById("tanggalKembali").value);
    const dendaPerHari = 1000;
    const batasHari = 7;

    const selisihWaktu = tanggalKembali - tanggalPinjam;
    const selisihHari = Math.ceil(selisihWaktu / (1000 * 60 * 60 * 24));

    let denda = 0;
    if (selisihHari > batasHari) {
      denda = (selisihHari - batasHari) * dendaPerHari;
    }

    document.getElementById("denda").value = denda;

    // Cek validasi agar tidak bisa submit langsung
    if (tanggalKembali < tanggalPinjam) {
      alert("Tanggal kembali tidak boleh sebelum tanggal pinjam!");
      return false;
    }

    return true;
  }
</script>

</html>
